server {
    listen ${PORT};
    server_name _;

    add_header X-Gateway "AuraMeet-Render-Gateway" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location ~ ^/(health|gateway/health)$ {
        default_type application/json;
        return 200 '{"status":"ok","service":"api-gateway","platform":"render-free"}';
    }

    location /api/v1/auth {
        proxy_pass https://${AUTH_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location /uploads/ {
        proxy_pass https://${AUTH_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1/personas {
        proxy_pass https://${PERSONA_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${PERSONA_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location /api/v1/sessions {
        proxy_pass https://${MEETING_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${MEETING_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location /ws/ {
        proxy_pass https://${MEETING_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${MEETING_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/v1/ai {
        proxy_pass https://${AI_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${AI_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location ~ ^/api/v1/(templates|schedule|stats|kafka) {
        proxy_pass https://${ANALYTICS_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${ANALYTICS_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass https://${FRONTEND_HOST};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${FRONTEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
