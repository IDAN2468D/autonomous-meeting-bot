server {
    listen ${PORT};
    server_name _;

    # Resolve public Render service hostnames dynamically at request time
    resolver 1.1.1.1 8.8.8.8 valid=30s ipv6=off;

    add_header X-Gateway "AuraMeet-Render-Gateway" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location ~ ^/(health|gateway/health)$ {
        default_type application/json;
        return 200 '{"status":"ok","service":"api-gateway","platform":"render-free"}';
    }

    location /api/v1/auth {
        set $auth_upstream "https://${AUTH_HOST}";
        proxy_pass $auth_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location /uploads/ {
        set $auth_upstream "https://${AUTH_HOST}";
        proxy_pass $auth_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1/personas {
        set $persona_upstream "https://${PERSONA_HOST}";
        proxy_pass $persona_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${PERSONA_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location /api/v1/sessions {
        set $meeting_upstream "https://${MEETING_HOST}";
        proxy_pass $meeting_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${MEETING_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location /ws/ {
        set $meeting_upstream "https://${MEETING_HOST}";
        proxy_pass $meeting_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${MEETING_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/v1/ai {
        set $ai_upstream "https://${AI_HOST}";
        proxy_pass $ai_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${AI_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    location ~ ^/api/v1/(templates|schedule|stats|kafka) {
        set $analytics_upstream "https://${ANALYTICS_HOST}";
        proxy_pass $analytics_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${ANALYTICS_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $frontend_upstream "https://${FRONTEND_HOST}";
        proxy_pass $frontend_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${FRONTEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
