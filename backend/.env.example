APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=meeting_bot_db
CHROMA_PERSIST_DIR=./chroma_data

# Multi-LLM Engine: auto | gemini | openai | demo
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=240
LLM_TOP_P=0.9

# Avatar Provider: simli | did | mock
AVATAR_PROVIDER=simli
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=tmp9i8bbq7c
DID_API_KEY=
DID_MOCK_MODE=false

# Server-Side Security (JWT)
JWT_SECRET_KEY=change-me-in-production-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_REQUIRED=false

# Kafka Event-Driven Architecture
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=meeting-bot-consumer

CORS_ORIGINS=http://localhost:3000
